{
  "name": "ss-cart-service",
  "version": "0.1.0",
  "description": "Shopping Cart microservice for SamStore",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:introspect": "prisma db pull",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
