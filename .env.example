# Application
APP_PORT=8083
APP_HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:123456@localhost:5432/ss_cart_db

# JWT (RS256 Public Key — same key used by API Gateway)
# Provide either path or raw PEM string
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public_key.pem

# Internal HMAC Secret (must match API Gateway GATEWAY_HMAC_SECRET)
GATEWAY_HMAC_SECRET=dev_secret_key_change_in_production
