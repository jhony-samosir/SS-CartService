generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cart {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.VarChar(255)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.VarChar(255)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.VarChar(255)

  userId    Int      @map("user_id")
  status    String   @default("active") @db.VarChar(50)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  notes     String?  @db.Text

  items     CartItem[]
  outboxEvents OutboxEvent[]

  @@map("carts")
}

model CartItem {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.VarChar(255)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.VarChar(255)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.VarChar(255)

  cartId          Int    @map("cart_id")
  productId       Int    @map("product_id")
  productPublicId String @map("product_public_id") @db.Uuid
  variantId       Int?   @map("variant_id")
  variantPublicId String? @map("variant_public_id") @db.Uuid

  productName String  @map("product_name") @db.VarChar(500)
  variantName String? @map("variant_name") @db.VarChar(255)
  sku         String? @db.VarChar(255)
  imageUrl    String? @map("image_url") @db.Text

  unitPrice    Decimal @map("unit_price") @db.Decimal(18, 2)
  currencyCode String  @default("IDR") @map("currency_code") @db.Char(3)

  quantity Int @default(1)

  sellerId   Int?    @map("seller_id")
  sellerName String? @map("seller_name") @db.VarChar(255)

  cart Cart @relation(fields: [cartId], references: [id])

  @@map("cart_items")
}

model OutboxEvent {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.VarChar(255)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.VarChar(255)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.VarChar(255)

  eventType     String @map("event_type") @db.VarChar(255)
  aggregateType String @default("cart") @map("aggregate_type") @db.VarChar(100)
  aggregateId   Int    @map("aggregate_id")
  payload       Json
  status        String @default("pending") @db.VarChar(50)
  retryCount    Int    @default(0) @map("retry_count")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  errorMessage  String?   @map("error_message") @db.Text

  cart Cart @relation(fields: [aggregateId], references: [id])

  @@map("outbox_events")
}

model InboxEvent {
  messageId     String    @id @map("message_id") @db.VarChar(255)
  eventType     String    @map("event_type") @db.VarChar(255)
  aggregateType String?   @map("aggregate_type") @db.VarChar(100)
  payload       Json
  status        String    @default("processed") @db.VarChar(50)
  processedAt   DateTime  @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("inbox_events")
}
